{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*\\.html|)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/blog/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/[...path]"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/[...path]"
    },
    {
      "source": "/than-so-hoc",
      "destination": "/than-so-hoc.html"
    },
    {
      "source": "/hop-tuoi",
      "destination": "/hop-tuoi.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/chinh-sach-bao-mat",
      "destination": "/chinh-sach-bao-mat.html"
    },
    {
      "source": "/dieu-khoan-su-dung",
      "destination": "/dieu-khoan-su-dung.html"
    },
    {
      "source": "/chinh-sach-hoan-tien-ho-tro",
      "destination": "/chinh-sach-hoan-tien-ho-tro.html"
    }
  ]
}
