{
  "cleanUrls": true,
  "functions": {
    "api/**": {
      "includeFiles": "data/**"
    }
  },
  "headers": [
    {
      "source": "/(.*\\.html|)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(google[a-zA-Z0-9]+)(?:\\.html)?",
      "destination": "/api?google_verify=$1"
    },
    {
      "source": "/(.*)google9f78d3cac1ee8064.html",
      "destination": "/api?google_verify=google9f78d3cac1ee8064"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api?blog_slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?render_sitemap=true"
    },
    {
      "source": "/robots.txt",
      "destination": "/api?render_robots=true"
    },
    {
      "source": "/than-so-hoc",
      "destination": "/than-so-hoc.html"
    },
    {
      "source": "/hop-tuoi",
      "destination": "/hop-tuoi.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/chinh-sach-bao-mat",
      "destination": "/chinh-sach-bao-mat.html"
    },
    {
      "source": "/dieu-khoan-su-dung",
      "destination": "/dieu-khoan-su-dung.html"
    },
    {
      "source": "/chinh-sach-hoan-tien-ho-tro",
      "destination": "/chinh-sach-hoan-tien-ho-tro.html"
    }
  ]
}
